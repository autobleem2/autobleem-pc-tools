// AutoBleemWinSetup.exe's resources: the manifest (common controls v6, DPI awareness), the icon, the shared
// look's two fonts (Red Hat Text, SIL OFL - the licence text sits next to the exe as RedHatText-OFL.txt) and
// this program's hero (apps/installer/ui, 640x150 and the 2x). Same shape as installer_exe.rc.
#include "../../common/ui_theme_ids.h"

1 24 "installer.manifest"
1 ICON "../../common/icons/AutoBleemWinSetup.ico"
UI_RES_FONT_MEDIUM RCDATA "../../common/resources/RedHatText-Medium.ttf"
UI_RES_FONT_SEMIBOLD RCDATA "../../common/resources/RedHatText-SemiBold.ttf"
// the hero of this program: hero-winsetup.png from autobleem-design (themes/ab2.0.0/design/pcinstall)
UI_RES_HERO RCDATA "../ui/hero-winsetup.png"
UI_RES_HERO_2X RCDATA "../ui/hero-winsetup@2x.png"
