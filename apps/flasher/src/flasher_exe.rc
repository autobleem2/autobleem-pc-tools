// AutoBleemFlasher.exe's resources: the manifest (common controls v6, DPI awareness, requireAdministrator),
// the icon, the shared look's two fonts (Red Hat Text, SIL OFL - the licence text sits next to the exe as
// RedHatText-OFL.txt) and this program's hero (apps/flasher/ui, 640x150 and the 2x). Same shape as
// installer_exe.rc.
#include "../../common/ui_theme_ids.h"

1 24 "flasher.manifest"
1 ICON "../../common/icons/AutoBleemFlasher.ico"
UI_RES_FONT_MEDIUM RCDATA "../../common/resources/RedHatText-Medium.ttf"
UI_RES_FONT_SEMIBOLD RCDATA "../../common/resources/RedHatText-SemiBold.ttf"
// the hero of this program: hero-flasher.png from autobleem-design (themes/ab2.0.0/design/pcinstall)
UI_RES_HERO RCDATA "../ui/hero-flasher.png"
UI_RES_HERO_2X RCDATA "../ui/hero-flasher@2x.png"
